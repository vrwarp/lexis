# Copy to .env next to docker-compose.yml and fill in.

# Required: the password. It signs you in the first time (to set up a passkey)
# and always works as the backup after that, so make it long and unique:
#   openssl rand -base64 24
LEXIS_PASSWORD=change-me

# The address you open lexis at. Passkeys are bound to this host, and requests
# from any other origin are refused. Passkeys need https (or localhost).
LEXIS_PUBLIC_URL=https://lexis.example.com

# Set to 1 when the site is served over https (it must be, for passkeys):
# secure __Host- cookie and HSTS.
COOKIE_SECURE=1

# How many reverse proxies sit in front (Caddy, nginx, Traefik, Synology's…).
# Needed to see real client addresses, which the password attempt limits use.
# Leave 0 if the container is reached directly.
LEXIS_TRUST_PROXY=1

# ---- Claude credential: pick ONE ----
# A) Nothing here (recommended). Open the web UI, click "Claude" at the bottom of
#    the sidebar, and sign in with your Claude subscription. The login is kept in
#    the data volume.
# B) A long-lived subscription token: run `claude setup-token` on any machine
#    with Claude Code, approve in the browser, paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
# C) An API key from platform.claude.com, billed per token. Outranks A and B.
ANTHROPIC_API_KEY=

# ---- Models (full model IDs) ----
# The strong model does the translation (primary/final translator, native critique,
# critique charter, metadata, style analysis). Never put a cheap model here: see
# docs/LESSONS.md.
LEXIS_TRANSLATION_MODEL=claude-opus-5-5
# Everything mechanical (extraction, glossary, omission/stray audits, packaging).
LEXIS_MECHANICAL_MODEL=claude-sonnet-5-5
# The orchestrator. Defaults to the mechanical model.
# LEXIS_ORCHESTRATOR_MODEL=claude-sonnet-5-5

# Effort per tier: low | medium | high | xhigh | max
# LEXIS_TRANSLATION_EFFORT=high
# LEXIS_MECHANICAL_EFFORT=medium
# LEXIS_ORCHESTRATOR_EFFORT=medium

# Echo the Claude Code subprocess's stderr to the container log.
# LEXIS_DEBUG=1
